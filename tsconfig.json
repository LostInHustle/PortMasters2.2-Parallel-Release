{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    // `strict` already turns on noImplicitAny. A line switching it back off
    // sat directly under this one, which quietly canceled part of the very
    // setting above it. Turning it back on produced zero errors, so the check
    // had been suppressing nothing but itself.
    "strict": true,
    "noEmit": true,
    // The tree is at zero unused locals and zero unused parameters. These two
    // keep it there, and the lint config's TypeScript-aware no-unused-vars
    // rule is an error as well; only the base rule it replaces is off.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // The Worker is a second TypeScript project with its own globals, so it
  // is checked by `npm run cf:typecheck` rather than by this one, and
  // Wrangler's local state is generated rather than authored.
  "exclude": ["node_modules", "cloudflare", ".wrangler"]
}
