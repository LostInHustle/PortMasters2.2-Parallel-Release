{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    // `strict` already turns on noImplicitAny. A line switching it back off
    // sat directly under this one, which quietly cancelled part of the very
    // setting above it. Turning it back on produced zero errors, so the check
    // had been suppressing nothing but itself.
    "strict": true,
    "noEmit": true,
    // The tree is at zero unused locals and zero unused parameters. These two
    // keep it there, because every one of the fifteen that were found had been
    // invisible: the lint config disables no-unused-vars, so nothing in the
    // normal check would ever have reported them.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
