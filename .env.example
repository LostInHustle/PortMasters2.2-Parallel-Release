# Copy this file to .env, then adjust the values below if you need to.
#
# DATABASE_URL points at the SQLite file that holds every account, room
# and voyage. The path is relative to prisma/schema.prisma, so
# file:../db/custom.db means db/custom.db in the project root. The file
# is created on first write, so a missing one is normal on a fresh setup.
DATABASE_URL=file:../db/custom.db

# The port the whole game answers on: the site, the API and the realtime
# channel together. Leave it unset to use 8080.
PORT=8080

# The address to bind. 0.0.0.0 lets other devices on your network reach
# the game, which is what a tunnel or a second player on the same wifi
# needs. Use 127.0.0.1 to keep it on this machine only.
HOST=0.0.0.0

# The code that admits an operator account through /admin. The register
# form there accepts no code but this one, so generate your own secret
# rather than copying this example, which is a placeholder and nothing
# more. An unset or empty value refuses every attempt: an installation
# that never sets one has no way in at all.
ADMIN_SETUP_CODE=change-me-to-a-secret-of-your-own

# The share of voyages that leave a telemetry record, as a fraction of
# one: 1 records every voyage, 0 records none, and 0.25 records a
# quarter of them. A record is written once, when a voyage ends, and
# nothing in the game reads one back, so this decides how much the
# harbor remembers rather than how it plays. Leave it unset to record
# every voyage.
TELEMETRY_SAMPLE_RATE=1

# A multiplier on the length of every phase of a round, from 0 to 10.
# 1 is the lengths the game was designed with, so this is for slowing a
# table down or moving it along rather than for tuning: a value above
# one gives a harbor more time in every phase, and a value below one
# gives it less. 0, or the word off, turns the clock off entirely and
# leaves every room advancing the way it did before the clock existed,
# each phase ending only when every captain has readied. Nothing about
# a voyage is stored differently with the clock off, so it is a safe
# thing to set and unsafe in no direction. Leave it unset for 1.
PHASE_CLOCK=1

# The provisions layer: the Larder, and the short rations a crew works
# through when it runs empty. Leave it unset to play with it on, which is
# the mode this branch is building toward. 0, or the word off, turns the
# whole layer off: nothing is eaten, nothing is slowed and nothing is
# drawn, and a voyage is stored no differently either way, since the
# Larder is a field every save carries whether or not a rule reads it.
#
# The NEXT_PUBLIC_ prefix is not decoration and it is the one thing to
# know before relying on this switch. The rules it gates run in the
# browser, where the engine runs, and a value without that prefix is not
# present in a client bundle at all. The cost is that the browser's copy
# of the value is fixed when the bundle is built, so turning the layer off
# takes a rebuild and a restart rather than a restart alone. The server
# reads the same value from the same file when it assembles an audit
# reveal, so both halves move together.
NEXT_PUBLIC_SURVIVAL=1
